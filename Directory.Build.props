<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Lets the Windows app build on Linux and macOS too (CI and contributors). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.0</Version>
    <Company>Blitztext für Windows contributors</Company>
    <Product>Blitztext für Windows</Product>
    <Copyright>Copyright (c) 2026 Blitztext contributors</Copyright>
  </PropertyGroup>
</Project>
