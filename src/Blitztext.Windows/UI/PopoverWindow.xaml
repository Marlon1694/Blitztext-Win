<Window x:Class="Blitztext.Windows.UI.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blitztext"
        Width="448"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Text}"
        Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="14">
        <!-- The shadow sits on its own layer, so the text above stays crisp. -->
        <Border CornerRadius="12" Background="{DynamicResource Brush.Page}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.3" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="12" Background="{DynamicResource Brush.Page}" BorderBrush="{DynamicResource Brush.CardBorder}"
                BorderThickness="1" ClipToBounds="True">
            <ContentControl x:Name="PageHost" Focusable="False" />
        </Border>
    </Grid>
</Window>
