<Window x:Class="Blitztext.Windows.UI.RecordingPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Blitztext.Windows.UI"
        Title="Blitztext Aufnahme"
        Width="180" Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        FontFamily="{StaticResource Font.Text}">
    <Window.Resources>
        <SolidColorBrush x:Key="Lilac" Color="#BB84DF" />
        <SolidColorBrush x:Key="Night" Color="#050722" Opacity="0.94" />
        <SolidColorBrush x:Key="Light" Color="#D9FFFFFF" />
    </Window.Resources>
    <!-- Night surface with lilac, the same in light and dark mode, so it reads on any window behind it. -->
    <Grid x:Name="Root" Width="148" Height="40" Cursor="Hand" MouseLeftButtonUp="OnClick">
        <Border CornerRadius="20" Background="{StaticResource Night}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.3" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="20" BorderThickness="1">
            <Border.BorderBrush>
                <SolidColorBrush Color="#BB84DF" Opacity="0.35" />
            </Border.BorderBrush>
        </Border>

        <!-- Recording -->
        <StackPanel x:Name="RecordingView" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="ModeGlyph" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Light}" Margin="0,0,10,0" />
            <ui:VoiceBars x:Name="Bars" Width="52" Height="22" BarBrush="{StaticResource Lilac}" BarCount="7" />
            <Border Width="20" Height="20" CornerRadius="10" Margin="10,0,0,0">
                <Border.Background>
                    <SolidColorBrush Color="White" Opacity="0.14" />
                </Border.Background>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="7" Foreground="{StaticResource Light}" />
            </Border>
        </StackPanel>

        <!-- Processing -->
        <StackPanel x:Name="ProcessingView" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <ui:TypingDots Width="30" Height="18" DotBrush="{StaticResource Lilac}" Margin="0,0,8,0" />
            <TextBlock Text="Schreibt" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Light}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Done -->
        <StackPanel x:Name="DoneView" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Foreground="{StaticResource Lilac}" Margin="0,0,8,0" />
            <TextBlock Text="Fertig" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Light}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
