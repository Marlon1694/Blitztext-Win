<UserControl x:Class="Blitztext.Windows.UI.Pages.OnboardingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="16,14,16,10">
            <StackPanel>
                <TextBlock Text="Willkommen" Style="{StaticResource Text.Title}" />
                <TextBlock Text="bei Blitztext für Windows" Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <Button Style="{StaticResource Button.Subtle}" Content="Später" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnLater" />
        </Grid>
        <Border Style="{StaticResource Divider}" />
        <StackPanel Margin="16">
            <TextBlock Text="Einmal einrichten, dann direkt loslegen." Style="{StaticResource Text.Headline}" FontSize="17" />
            <TextBlock Margin="0,6,0,14" Style="{StaticResource Text.Caption}" FontSize="12.5"
                       Text="Ein lokales Sprachmodell reicht. Danach sprechen und einfügen, alles auf diesem PC." />

            <Border Style="{StaticResource Card}" Padding="14,4">
                <StackPanel>
                    <DockPanel Margin="0,10">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="1" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Sprachmodell laden" Style="{StaticResource Text.Label}" FontSize="13" />
                            <TextBlock Text="In den Einstellungen ein lokales Modell installieren, zum Beispiel Parakeet v3." Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Margin="0,10">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="2" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Mikrofon erlauben" Style="{StaticResource Text.Label}" FontSize="13" />
                            <TextBlock Text="Windows fragt nicht nach: unter Datenschutz und Sicherheit, Mikrofon, muss der Zugriff für Desktop-Apps an sein." Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel Margin="0,10">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="3" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Strg + Win halten und sprechen" Style="{StaticResource Text.Label}" FontSize="13" />
                            <TextBlock Text="Loslassen, und der Text landet am Cursor. Oder einen Modus hier im Fenster starten." Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource Button.Filled}" Margin="0,16,0,0" HorizontalAlignment="Stretch" Click="OnSetup">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" Foreground="{DynamicResource Brush.OnAccent}" Margin="0,0,8,0" FontSize="12" />
                    <TextBlock Text="Jetzt einrichten" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
