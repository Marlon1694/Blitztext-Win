<UserControl x:Class="Blitztext.Windows.UI.Pages.AudioFilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Blitztext.Windows.UI">
    <StackPanel>
        <Grid Margin="12,12,16,10">
            <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Left" Click="OnBack" ToolTip="Zurück" AutomationProperties.Name="Zurück">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="13" />
            </Button>
            <TextBlock Text="Audiodatei" Style="{StaticResource Text.Headline}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Border Style="{StaticResource Divider}" />

        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding DurationText}" Style="{StaticResource Text.Small}"
                                   Visibility="{Binding DurationText, Converter={StaticResource NotNullToVis}}" />
                    </StackPanel>
                </DockPanel>

                <!-- Working -->
                <Border x:Name="WorkingView" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed">
                    <DockPanel>
                        <ui:TypingDots DockPanel.Dock="Left" Width="30" Height="16" DotBrush="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" FontSize="12.5" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Failed -->
                <Border x:Name="FailedView" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource Brush.Danger}" Margin="0,0,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Danger}" FontSize="12.5" />
                    </DockPanel>
                </Border>

                <!-- Done -->
                <Border x:Name="DoneView" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding Copied, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{DynamicResource Brush.Ready}" Margin="0,0,4,0" />
                                <TextBlock Text="In der Zwischenablage" Style="{StaticResource Text.Small}" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <TextBlock x:Name="ModeText" Style="{StaticResource Text.Small}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </DockPanel>
                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 Padding="0" FontSize="13" MaxHeight="220" VerticalScrollBarVisibility="Auto" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource Button.Tonal}" Margin="0,0,8,0" Click="OnCopy">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,6,0" />
                                    <TextBlock Text="Kopieren" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RewriteButton" Style="{StaticResource Button.Tonal}" Click="OnRewriteMenu">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="12" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,6,0" />
                                    <TextBlock Text="Umschreiben als …" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Die Datei wird auf diesem PC transkribiert und nicht verändert." Style="{StaticResource Text.Small}" Margin="2,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Style="{StaticResource Divider}" />
        <Grid Margin="16,10">
            <Button Style="{StaticResource Button.Tonal}" HorizontalAlignment="Right" Click="OnChoose" IsEnabled="{Binding IsWorking, Converter={StaticResource InverseBool}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,6,0" />
                    <TextBlock Text="Andere Datei …" />
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
