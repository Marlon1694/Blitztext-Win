<UserControl x:Class="Blitztext.Windows.UI.Pages.WhatsNewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Margin="16,14,16,10">
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Einmal kurz, dann geht es weiter wie gewohnt." Style="{StaticResource Text.Caption}" />
        </StackPanel>
        <Border Style="{StaticResource Divider}" />
        <StackPanel Margin="16">
            <ItemsControl x:Name="Items" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16" Width="24"
                                       VerticalAlignment="Top" Margin="0,1,12,0" Foreground="{DynamicResource Brush.Accent}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" FontSize="13" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="SetupNotice" Style="{StaticResource Notice}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="SetupTitle" Style="{StaticResource Text.Label}" />
                    <TextBlock x:Name="SetupDetail" Style="{StaticResource Text.Caption}" />
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Style="{StaticResource Divider}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,10">
            <Button x:Name="SetupButton" Style="{StaticResource Button.Tonal}" Content="Einrichten" Margin="0,0,8,0" Click="OnSetup" Visibility="Collapsed" />
            <Button Style="{StaticResource Button.Filled}" Content="Verstanden" Click="OnDone" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
