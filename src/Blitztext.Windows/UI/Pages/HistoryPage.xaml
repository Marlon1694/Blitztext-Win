<UserControl x:Class="Blitztext.Windows.UI.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="12,12,16,10">
            <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Left" Click="OnBack" ToolTip="Zurück" AutomationProperties.Name="Zurück">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="13" />
            </Button>
            <TextBlock Text="Verlauf" Style="{StaticResource Text.Headline}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Border Style="{StaticResource Divider}" />

        <!-- Off -->
        <StackPanel Margin="24,40" Visibility="{Binding IsOff, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="24" Foreground="{DynamicResource Brush.TextTertiary}" />
            <TextBlock Text="Verlauf ist aus" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" Margin="0,10,0,4" />
            <TextBlock Text="In den Einstellungen unter „Aufnahme &amp; Einfügen“ einschalten." Style="{StaticResource Text.Caption}" TextAlignment="Center" />
        </StackPanel>

        <!-- Empty -->
        <StackPanel Margin="24,40" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="24" Foreground="{DynamicResource Brush.TextTertiary}" />
            <TextBlock Text="Noch nichts im Verlauf" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" Margin="0,10,0,4" />
            <TextBlock Text="{Binding EmptyDetail}" Style="{StaticResource Text.Caption}" TextAlignment="Center" />
        </StackPanel>

        <!-- Entries -->
        <StackPanel Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}">
            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Padding="12,10">
                <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Close}" Click="OnDelete" Tag="{Binding Entry}" ToolTip="Eintrag löschen" />
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Header}" Style="{StaticResource Text.Small}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                             TextWrapping="Wrap" MaxHeight="64" Margin="0,6,0,6" FontSize="12.5" VerticalScrollBarVisibility="Disabled" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Button.Subtle}" Foreground="{DynamicResource Brush.AccentText}" Click="OnPaste" Tag="{Binding Entry}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="11" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,5,0" />
                                                <TextBlock Text="Einfügen" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Button.Subtle}" Foreground="{DynamicResource Brush.AccentText}" Click="OnCopy" Tag="{Binding Entry}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="11" Foreground="{DynamicResource Brush.AccentText}" Margin="0,0,5,0" />
                                                <TextBlock Text="Kopieren" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Grid Margin="16,0,16,10">
                <TextBlock Text="{Binding Footer}" Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
                <Button Style="{StaticResource Button.Subtle}" Content="Alles löschen" HorizontalAlignment="Right" Click="OnClear" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
